# --- Supabase (Settings > API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin login ---
# Generate this by running: npm run hash-password
# (it will ask you to type a password and print a ready-to-paste line below.
# It's base64-encoded on purpose — don't hand-type or edit it, or paste a
# raw bcrypt hash here, since Next.js will mangle the "$" characters in it.)
ADMIN_PASSWORD_HASH=

# Any long random string. You can generate one at https://generate-secret.vercel.app/32
JWT_SECRET=
